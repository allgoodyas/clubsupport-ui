          <button class="action-btn" (click)="manageSubscriptions()">
            <span class="action-icon">📋</span>
            <span class="action-text">{{ 'DASHBOARD.SUBSCRIPTION_PLANS' | translate }}</span>
          </button>

          <button class="action-btn" (click)="browseSubscriptions()">
            <span class="action-icon">🎯</span>
            <span class="action-text">{{ 'DASHBOARD.BROWSE_PLANS' | translate }}</span>
          </button>

          <button class="action-btn" (click)="openSendNotification()">
            <span class="action-icon">📢</span>
            <span class="action-text">Send Notification</span>
          </button>