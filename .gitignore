# ============================================================
# Club Management Web — Angular .gitignore
# ============================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
/node_modules/

# ── Compiled output ───────────────────────────────────────────────────────────
/dist/
/tmp/
/out-tsc/
/bazel-out/

# ── Angular cache ─────────────────────────────────────────────────────────────
/.angular/cache
/.angular/

# ── Environment files — SENSITIVE ─────────────────────────────────────────────
# Contain API URLs, keys, and other secrets.
# Commit environment.ts (dev defaults), exclude production overrides.
src/environments/environment.prod.ts
src/environments/environment.staging.ts
src/environments/environment.local.ts
.env
.env.*
secrets.ts
secrets.json

# ── IDE & Editors ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws

# VS Code — keep shared settings, ignore personal/local settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# ── Build & Test artifacts ────────────────────────────────────────────────────
/coverage/
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings

# ── Logs ──────────────────────────────────────────────────────────────────────
npm-debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# ── Package manager locks ──────────────────────────────────────────────────────
# Commit package-lock.json (npm) OR yarn.lock — not both.
# If you use npm, keep package-lock.json and add yarn.lock below:
# yarn.lock

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.orig
*.swp
*.tmp
*.sublime-workspace
.sass-cache
.project
.classpath
.c9/
*.launch
.settings/
